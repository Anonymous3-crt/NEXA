# Server
PORT=3001
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:3001

# Resend (transactional email) — get from https://resend.com
# If unset, verification codes / reset links are only logged to the console
RESEND_API_KEY=
EMAIL_FROM=Nexa <onboarding@resend.dev>

# Turso (production database) — get from https://turso.tech
# If unset, the app falls back to a local sql.js file (server/db/nexa.db)
TURSO_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob (production file uploads) — get from Vercel dashboard
# If unset, uploads are written to server/uploads/ locally
BLOB_READ_WRITE_TOKEN=
